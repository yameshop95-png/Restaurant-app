{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "functions": {
    "api/analyze.js": {
      "maxDuration": 120
    },
    "api/keepalive.js": {
      "maxDuration": 15
    },
    "api/backup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 20 * * 6"
    }
  ]
}
