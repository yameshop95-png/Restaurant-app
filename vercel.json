{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.wodovn.xyz"
        }
      ],
      "destination": "/order",
      "statusCode": 307
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wodovn.xyz"
        }
      ],
      "destination": "/order",
      "statusCode": 307
    }
  ],
  "functions": {
    "api/analyze.js": {
      "maxDuration": 120
    },
    "api/keepalive.js": {
      "maxDuration": 15
    },
    "api/backup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 20 * * 6"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "restaurant-app-seven-lime.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}