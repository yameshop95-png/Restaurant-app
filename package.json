{
  "name": "restaurant-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/site/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test:sync": "node tests/sync-queue/run.mjs",
    "test:cache": "node tests/list-cache/run.mjs",
    "test:performance": "node tests/performance/run.mjs",
    "test:dishprofit": "node tests/dish-profit/run.mjs",
    "test:insights": "node tests/report-insights/run.mjs",
    "test:classify": "node tests/track-classify/run.mjs",
    "test:donut": "node tests/donut/run.mjs",
    "test:batches": "node tests/batches/run.mjs",
    "test:routelinks": "node tests/route-links/run.mjs",
    "build:bridge": "esbuild print-bridge/src/backup-entry.js --bundle --platform=node --format=esm --target=node18 --outfile=print-bridge/backup-lib.mjs --banner:js=\"// TỰ SINH từ print-bridge/src/backup-entry.js (npm run build:bridge). Đừng sửa tay.\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.14",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
